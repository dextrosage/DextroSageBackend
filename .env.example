# FastAPI Security & JWT Configuration
SECRET_KEY=your-secure-random-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection URIs
DATABASE_URL=mysql+asyncmy://username:password@localhost:3306/database_name
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/
DB_NAME=DextroSage

# SMTP Mail Server Settings (Brevo / Gmail / Custom SMTP)
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username-email@domain.com
SMTP_PASSWORD=your-smtp-relay-password

# Email API Providers (Optional / Fallbacks)
RESEND_API_KEY=re_your_resend_api_key_here
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_EMAIL=your-sender-email-address@domain.com
